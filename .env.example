# URL used in the GitHub OAuth callback.
APP_URL=http://localhost:3000

# Create an OAuth App in GitHub Developer settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# At least 32 characters. Never commit the real value.
ADMIN_SESSION_SECRET=

# Repository and branch receiving content Pull Requests.
GITHUB_REPOSITORY=informatique-cmd/psd-lfjp
GITHUB_BASE_BRANCH=main

# Optional comma-separated GitHub usernames allowed to administer the site.
ADMIN_GITHUB_USERS=
